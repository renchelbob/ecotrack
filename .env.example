# EcoTrack Environment Configuration Template
# Copy this file to .env and fill in real secrets before starting the application.

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
API_BIND_HOST=127.0.0.1
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Database Configuration (PostgreSQL 17 + PostGIS 3.5)
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=ecotrack_dev_password_2026
POSTGRES_DB=ecotrack
DATABASE_URL=postgresql://ecotrack:ecotrack_dev_password_2026@127.0.0.1:5432/ecotrack
DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=16

# Security & Tokens
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev_jwt_secret_key_minimum_64_characters_long_for_security_testing_2026
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
FZ152_DELETION_HMAC_SECRET=dev_152fz_hmac_secret_key_minimum_64_characters_for_audit_receipts_2026

# OAuth 2.1 Providers
YANDEX_OAUTH_CLIENT_ID=mock_yandex_client_id
YANDEX_OAUTH_CLIENT_SECRET=mock_yandex_client_secret
YANDEX_OAUTH_REDIRECT_URI=ecotrack://auth/callback

VK_OAUTH_CLIENT_ID=mock_vk_client_id
VK_OAUTH_CLIENT_SECRET=mock_vk_client_secret
VK_OAUTH_REDIRECT_URI=ecotrack://auth/callback

# Google OAuth (Academic/Lab Mode with 406-FZ Warning & Formal Phone Gate)
ACADEMIC_LAB_ALLOW_GOOGLE_OAUTH=true
GOOGLE_OAUTH_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=mock_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=ecotrack://auth/callback

# Push Notification Provider (noop for local dev, fcm for Firebase)
PUSH_PROVIDER_BACKEND=noop
FCM_SERVICE_ACCOUNT_JSON_PATH=/app/secrets/fcm-service-account.json

# PostGIS ETL & Open Data Pipelines
OSM_REGION_PBF_URL=https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf
OSM_BBOX_FILTER=36.80,55.10,38.20,56.10
DATA_MOS_RU_API_KEY=
